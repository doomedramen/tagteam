{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"jsx": "react-jsx",
		"allowImportingTsExtensions": true,
		"paths": { "@/*": ["./src/*"] },
		"types": ["vite/client"]
	},
	"include": [
		"src",
		"e2e",
		"e2e-smoke",
