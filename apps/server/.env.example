# Required: random secret, at least 32 characters (e.g. `openssl rand -base64 32`).
AUTH_SECRET=

# Public URL users open (behind Cloudflare Access / cloudflared). Also sets the passkey RP id.
# In development, open Vite at http://localhost:5173 and use BASE_URL=http://localhost:5173.
BASE_URL=http://localhost:3000

# Optional
PORT=3000
DATABASE_PATH=./data/tagteam.db
# MIGRATIONS_DIR=./drizzle   # set by the Docker image; only needed when running a bundled build elsewhere
# WEB_DIR=../web/dist       # serve built web app; unset when Vite serves it in development
# RP_ID=tagteam.example.com   # defaults to BASE_URL host name
# RP_NAME=TagTeam
# Generate once with `pnpm --filter @tagteam/server exec web-push generate-vapid-keys`.
# Keep the private key stable. All three values enable push notifications.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=https://tagteam.example.com
